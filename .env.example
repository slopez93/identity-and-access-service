GRPC_PORT=50051
AWS_REGION=eu-west-1

COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_XXXXXXXX
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXX
COGNITO_USER_CLIENT_ID=frontend-app-client-id

# Generic M2M registry. Keys are internal service IDs.
# Keep real secrets out of source control. In EKS inject this value from a Secret.
COGNITO_SERVICE_CLIENTS='{"payments-service":{"client_id":"payments-client-id","client_secret":"replace-me","allowed_scopes":["financial-api/transactions.execute","financial-api/payments.execute"]}}'

DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_access
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

TRANSACTION_READ_SCOPE=financial-api/transactions.read
TRANSACTION_EXECUTE_SCOPE=financial-api/transactions.execute
TRANSACTION_CREATE_SCOPE=financial-api/transactions.create
PAYMENT_READ_SCOPE=financial-api/payments.read
PAYMENT_EXECUTE_SCOPE=financial-api/payments.execute
ACCOUNT_READ_SCOPE=financial-api/accounts.read
ACCOUNT_UPDATE_SCOPE=financial-api/accounts.update
